#!/usr/bin/env bash
# rhtr — Red Hat Training Runner
set -euo pipefail

# Resolve repo root from the real path of this script (survives symlinks)
RHTR_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE_DIR="$RHTR_DIR/.state"

# Source all shared libraries
source "$RHTR_DIR/lib/core.sh"
source "$RHTR_DIR/lib/vm.sh"
source "$RHTR_DIR/lib/select.sh"
source "$RHTR_DIR/lib/report.sh"
source "$RHTR_DIR/lib/progress.sh"
source "$RHTR_DIR/lib/list.sh"
source "$RHTR_DIR/lib/exam.sh"
source "$RHTR_DIR/lib/history.sh"
source "$RHTR_DIR/lib/lint.sh"

# ── usage ─────────────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'

  rhtr — Red Hat Training Runner

  Usage:
    rhtr list-certs
    rhtr import-image <alias> <path-to-qcow2>
    rhtr overview                 (best/last score per topic, across all certs)
    rhtr <cert> <command> [options]

  Session commands:
    new       [--profile <name>] [--fixed <name>] [--topic <ch>] [--rhel <8|9|10>] [--format training|exam]
    train     [--topic <ch>] [--difficulty easy|medium|hard] [--rhel <8|9|10>] [--format training|exam]
    shell     [--node <name>]
    console   [--node <name>]   (raw serial console — for GRUB/rd.break/rescue mode)
    grade     [--task <task-number>]   (omit --task to grade the whole session)
    hint      [<task-number>]
    reset
    destroy
    status
    tasks     (show tasks for active session or last session)
    save      [<label>]   (save last graded exam's per-topic scores to history)
    remember  [<label>]   (alias for save)
    overview              (best/last score per topic, this cert only)

  Discovery commands (no VM required):
    list-topics
    list-tasks    [--topic <ch>] [--difficulty <level>] [--rhel <version>]
    list-profiles [--format training|exam]
    list-fixed    [--format training|exam]
    show          <chapter/task-variant> [--format training|exam]
    progress      [--topic <ch>]
    lint          [<chapter/task-variant>] [--topic <ch>] [--format training|exam]

  --format training|exam (default: training) selects which task pool a session/discovery
  command uses. "training" is certs/<cert>/tasks/ (learning-oriented, module-name grading
  for RHCE). "exam" is certs/<cert>/tasks-exam/ (outcome-only, live-state grading) —
  currently populated for RHCE only; errors cleanly if the current cert has no pool yet.

EOF
}

# ── argument parsing ──────────────────────────────────────────────────────────
[[ $# -eq 0 ]] && usage && exit 0

# Global commands that don't need a cert
case "$1" in
  list-certs)   cmd_list_certs; exit 0 ;;
  import-image) shift; vm_import_image "$@"; exit 0 ;;
  overview)     cmd_overview_all; exit 0 ;;
  --help|-h)    usage; exit 0 ;;
esac

# All other commands: rhtr <cert> <command> [args...]
CERT="$1"; shift
[[ $# -eq 0 ]] && usage && exit 1

CMD="$1"; shift

# Load cert config if it exists
CERT_CONF="$RHTR_DIR/certs/$CERT/cert.conf"
[[ -f "$CERT_CONF" ]] || die "Unknown cert: '$CERT'  (no certs/$CERT/cert.conf found)"
source "$CERT_CONF"

# Load topology so VM_NAMES and topology_* functions are available when needed
TOPOLOGY_FILE="$RHTR_DIR/certs/$CERT/topology.sh"
[[ -f "$TOPOLOGY_FILE" ]] && source "$TOPOLOGY_FILE"

# ── dispatch ──────────────────────────────────────────────────────────────────
case "$CMD" in
  # Session
  new)          cmd_new "$@" ;;
  train)        cmd_train "$@" ;;
  shell)        cmd_shell "$@" ;;
  console)      cmd_console "$@" ;;
  grade)        cmd_grade "$@" ;;
  hint)         cmd_hint "$@" ;;
  reset)        cmd_reset ;;
  destroy)      cmd_destroy ;;
  status)       cmd_status ;;
  tasks)        cmd_tasks ;;
  save)         cmd_save "$@" ;;
  remember)     cmd_save "$@" ;;
  overview)     cmd_overview ;;

  # Discovery
  list-topics)   cmd_list_topics ;;
  list-tasks)    cmd_list_tasks "$@" ;;
  list-profiles) cmd_list_profiles "$@" ;;
  list-fixed)    cmd_list_fixed "$@" ;;
  show)          cmd_show_task "$@" ;;
  progress)      cmd_progress "$@" ;;
  lint)          cmd_lint "$@" ;;

  *) echo "Unknown command: $CMD"; usage; exit 1 ;;
esac
